root = true

[*.{kt,kts}]
# Baseline ruleset: ktlint's official code style.
ktlint_code_style = ktlint_official

# @Composable functions are PascalCase by convention — never flag them as
# function-naming violations (a Compose requirement, not a style choice).
ktlint_function_naming_ignore_when_annotated_with = Composable

# Line length: raised from the ktlint_official default of 140 to 160 to fit
# this KMP codebase's long fully-qualified type names and localized strings.
# Genuinely over-long logic is still wrapped; a handful of unbreakable JSON /
# translation string literals carry an inline @Suppress instead.
max_line_length = 160

# --- Rules disabled after reviewing every violation they produced ---

# Wildcard imports are permitted project-wide; expanding ~900 call sites is
# churn without payoff and the IDE's optimize-imports already governs this.
ktlint_standard_no-wildcard-imports = disabled

# Consecutive comments (a block comment followed by an EOL comment) are used
# deliberately here; ktlint-official's opinion adds noise without value.
ktlint_standard_no-consecutive-comments = disabled

# Filenames deliberately follow project conventions that this rule rejects:
# expect/actual suffixes (FileSystemBrowserAndroid/Desktop), Dto-suffixed
# files, and lowercase top-level-function files (initDB.kt, configureKoin.kt).
# Several offenders also sit in the safety-critical TSE tree — renaming files
# there is out of scope. Enforcing would force churny, risky renames.
ktlint_standard_filename = disabled

# The codebase intentionally uses PascalCase Compose design tokens (the
# Material3 *Defaults convention, e.g. PosCardDefaults.CardPadding) and
# SCREAMING_SNAKE constant-style vals, including in safety-critical TSE code.
ktlint_standard_property-naming = disabled

# Idiomatic backing fields (private var _foo backing a state accessor) are
# used throughout; renaming them is churn without payoff.
ktlint_standard_backing-property-naming = disabled

# Never lint generated sources (Compose resources, SQLDelight, KSP output, …).
# ktlint reads this per-file at lint time, so it is unaffected by Gradle
# source-set / task-creation ordering.
[**/build/**]
ktlint = disabled

# GoldenVectors.kt is generated by GoldenVectorGenerator, but unlike the sources above it lives in
# src/commonTest rather than build/: the conformance suite runs on jvm, wasm and iOS, so the corpus
# has to be a compiled source in commonTest. It is still generated output — the header says "do not
# hand-edit" — and regenerating it (./gradlew :platform-money:jvmTest) emits formatting ktlint rejects. The
# failure mode is nasty: running the money tests leaves the tree dirty and ktlintCheck red, and the
# rewrite then rides into whatever is committed next.
[**/GoldenVectors.kt]
ktlint = disabled
