<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Human-readable console appender (dev/IDE) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%X{traceId:---------}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Structured JSON file appender (production/SSH) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/application.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>code</includeMdcKeyName>
            <includeMdcKeyName>statusCode</includeMdcKeyName>
            <includeMdcKeyName>employeeId</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>duration_ms</includeMdcKeyName>
        </encoder>
        <!-- Daily rotation -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Dedicated error log: ERROR-level only, plain text with traceId/code/statusCode prefix.
         Support workflow: user shares traceId from PosErrorDialog -> ops greps error.log. -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] [%X{code:-}] [%X{statusCode:-}] %logger - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Client-reported errors: everything the till or web admin actually showed a user.
         Kept out of error.log so a client-side failure is never mistaken for a server fault.
         Same folder as the rest, so support has one place to look. -->
    <appender name="CLIENT_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/client-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/client-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{clientApp:-}] [%X{clientErrorId:-}] [%X{traceId:-}] [%X{code:-}] [%X{httpStatus:-}] screen=%X{screen:-} employee=%X{employeeNumber:-} device=%X{deviceId:-} version=%X{appVersion:-} - %msg%n%X{exceptionType:-}%n%X{exceptionMessage:-}%n%X{stackTrace:-}%n</pattern>
        </encoder>
    </appender>

    <!-- Rejected requests (4xx): why a request was refused, findable by traceId.
         Deliberately NOT error.log: a 4xx is the client's outcome, not a server fault
         (E2E-2026-09-15 N12). Deliberately NOT application.log: a burst of expired-token 401s
         must not push that file's 7 days of real history out. JSON so the maintainer log search
         can read the structured fields; the detail text is scrubbed at read time, never at rest. -->
    <appender name="REJECTED_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/rejected.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/rejected.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>code</includeMdcKeyName>
            <includeMdcKeyName>statusCode</includeMdcKeyName>
            <includeMdcKeyName>employeeId</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- additivity=false: a client error belongs in client-error.log only, not error.log. -->
    <logger name="client-error" level="ERROR" additivity="false">
        <appender-ref ref="CLIENT_ERROR_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- additivity=false: a rejection belongs in rejected.log only. -->
    <logger name="rejected" level="INFO" additivity="false">
        <appender-ref ref="REJECTED_FILE" />
    </logger>

    <!-- Every logger below has additivity=false, so it never reaches the root logger: each one
         names ERROR_FILE itself (its ThresholdFilter keeps only ERROR). Without that, error.log
         stayed empty while application.log held the errors. -->
    <!-- Database stack -->
    <logger name="Exposed" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    <logger name="com.zaxxer.hikari" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    <logger name="org.postgresql" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    <logger name="org.example.project.database" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- All feature services including TSE (routine ops, health checks, queue processing) -->
    <logger name="org.example.project.features" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- TSE module (pos-tse: maintenance tasks, health checks, operations) -->
    <logger name="org.example.project.tse" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Core services (WebSocket, routes) -->
    <logger name="org.example.project.core" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Request/response logging (details at DEBUG, summary at INFO via CallLogging) -->
    <logger name="HttpCallLogger" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Infrastructure startup logs are fine at INFO (one-time) -->
    <logger name="org.example.project.infrastructure" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    <logger name="org.example.project.desktop" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Ktor framework -->
    <logger name="io.ktor" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Netty -->
    <logger name="io.netty" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
