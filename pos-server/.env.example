# pos-server — local dev environment
#
# Copy to `pos-server/.env` and adjust. `./gradlew :pos-server:run` loads it automatically
# (see the `run` task in build.gradle.kts). `.env` is git-ignored; this template is committed.
# Real environment variables override anything set here, so CI and one-off overrides still win.
#
# Every key mirrors a `${VAR:default}` in src/main/resources/application.yaml.

# --- Auth -------------------------------------------------------------------------------------
# Development mode bypasses the startup guard that rejects the weak default JWT secret, so local
# runs come up without a strong secret. Set it false to exercise the real auth path — then a
# strong JWT_SECRET (>= 32 chars) is required or the server refuses to boot.
JWT_DEVELOPMENT_MODE=true
JWT_SECRET=change-me

# --- Embedded database (safety: keep this isolated!) ------------------------------------------
# The DEFAULT EMBEDDED_PG_DATA_DIR is the real "~/POS Server" data directory, and the app can
# TRUNCATE it on restore. Point dev at its own directory so `run` never touches real data.
# A relative path is resolved under pos-server/ (so `.dev-data/…` is git-ignored in this repo).
DATABASE_MODE=embedded
EMBEDDED_PG_PORT=5442
EMBEDDED_PG_DATA_DIR=.dev-data/postgresql
# EMBEDDED_PG_DATABASE=pos_db
# EMBEDDED_PG_USERNAME=pos
# EMBEDDED_PG_PASSWORD=pos

# --- Server -----------------------------------------------------------------------------------
# HOST=0.0.0.0
