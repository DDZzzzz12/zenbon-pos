<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Backup and device transfer are off: a transferred device token would clone a fiscal terminal.

        allowBackup="false" already disables all backup and device transfer on API 29–30, so a
        fullBackupContent rule file would be dead config; dataExtractionRules covers API 31 and later.
        tools:ignore="DataExtractionRules" silences lint's request for that dead file.

        tools:replace lists android:allowBackup because the qr-kit-android and cmpfilepicker-android
        libraries declare allowBackup="true", and the manifest merge would otherwise fail on the conflict.
    -->
    <application
        android:name=".PosApplication"
        tools:replace="android:name,android:allowBackup"
        tools:ignore="DataExtractionRules"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Rotation and window resizes are handled by Compose (LocalConfiguration / window size
             class), not by recreating the activity: a recreation rebuilt the whole till UI, re-ran
             every screen's loads and dropped its remembered state, e.g. the open PDF's page. -->
        <activity
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="org.example.project.core.notification.PosNotificationService"
            android:foregroundServiceType="remoteMessaging"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:node="replace">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
