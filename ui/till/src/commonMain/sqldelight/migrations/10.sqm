-- Migration from version 10 to version 11: local_payment_types gains creates_receivable, mirroring
-- the server's payment_type.creates_receivable (a tender settled "auf Rechnung" opens a receivable
-- rather than taking money). The till uses it to keep receivable-opening tenders out of the
-- "settle receivable" picker.
--
-- local_payment_types is created at runtime via CREATE TABLE IF NOT EXISTS in the .sq, not by any
-- migration, so the verifier's migration-derived schema does not know it. Re-declare it here first
-- (pre-change columns, IF NOT EXISTS — a no-op on a real device that already has it), then add the
-- column. Same shape as 4.sqm's ALTER of local_product_extras. Default 0: every existing local row
-- reads as non-receivable until the next sync overwrites it from the server.
CREATE TABLE IF NOT EXISTS local_payment_types (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    en_name TEXT,
    ch_name TEXT,
    is_active INTEGER NOT NULL DEFAULT 1
);

ALTER TABLE local_payment_types ADD COLUMN creates_receivable INTEGER NOT NULL DEFAULT 0;
