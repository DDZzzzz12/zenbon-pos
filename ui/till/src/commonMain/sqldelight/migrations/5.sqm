-- Migration from version 5 to version 6: local cache for tables + room elements.
CREATE TABLE IF NOT EXISTS local_r_tables (
    id INTEGER NOT NULL PRIMARY KEY,
    table_number TEXT NOT NULL,
    seats INTEGER NOT NULL DEFAULT 0,
    location_type_id INTEGER NOT NULL,
    location_type_name TEXT NOT NULL,
    is_virtual INTEGER NOT NULL DEFAULT 0,
    is_takeaway INTEGER NOT NULL DEFAULT 0,
    table_status TEXT NOT NULL,
    current_session_id INTEGER,
    current_employee_number TEXT,
    grid_x INTEGER,
    grid_y INTEGER,
    rotation REAL,
    grid_width INTEGER,
    grid_height INTEGER,
    is_training INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1,
    assignment_priority INTEGER NOT NULL DEFAULT 0,
    open_amount TEXT
);

CREATE TABLE IF NOT EXISTS local_room_elements (
    id INTEGER NOT NULL PRIMARY KEY,
    element_type TEXT NOT NULL,
    grid_x INTEGER NOT NULL,
    grid_y INTEGER NOT NULL,
    grid_width INTEGER NOT NULL,
    grid_height INTEGER NOT NULL,
    rotation REAL NOT NULL DEFAULT 0.0,
    location_type_id INTEGER NOT NULL,
    metadata TEXT
);
