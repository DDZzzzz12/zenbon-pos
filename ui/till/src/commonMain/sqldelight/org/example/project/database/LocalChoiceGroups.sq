CREATE TABLE IF NOT EXISTS local_choice_groups (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    en_name TEXT,
    ch_name TEXT,
    min_selections INTEGER NOT NULL DEFAULT 0,
    max_selections INTEGER NOT NULL DEFAULT 1,
    is_active INTEGER NOT NULL DEFAULT 1
);

insertOrUpdate:
INSERT OR REPLACE INTO local_choice_groups(id, name, en_name, ch_name, min_selections, max_selections, is_active)
VALUES (?, ?, ?, ?, ?, ?, ?);

getAll:
SELECT * FROM local_choice_groups WHERE is_active = 1;

getById:
SELECT * FROM local_choice_groups WHERE id = ?;

deleteById:
DELETE FROM local_choice_groups WHERE id = ?;

clearAll:
DELETE FROM local_choice_groups;
